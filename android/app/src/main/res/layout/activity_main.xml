<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#FAF9F6">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 Kokoro AI Ebook Reader"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="On-device neural TTS with 0 ms gapless lookahead reading."
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Convert & Import Action Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#BBDEFB">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📥 Convert or Open Ebook"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Convert EPUB or PDF into clean text with formatted chapters, or open an existing plain text file directly."
                    android:textSize="12sp"
                    android:textColor="#555555" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConvertEbook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Convert EPUB or PDF to Text"
                    app:icon="@android:drawable/ic_menu_upload"
                    android:backgroundTint="#1976D2"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenTxt"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open Plain Text (.txt) File"
                    app:icon="@android:drawable/ic_menu_agenda" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Local Library Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📚 My Saved Books"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <Button
                android:id="@+id/btnAddSample"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ Add Sample"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Library RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLibrary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvEmptyLibrary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No books saved yet.\nTap 'Convert EPUB or PDF' or 'Open Plain Text' above to get started!"
            android:gravity="center"
            android:textColor="#888888"
            android:textSize="13sp"
            android:padding="24dp"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <!-- System TTS Section (Collapsible / Preview) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 System TTS Voice Preview"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#444444" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_voice"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/voiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/sampleTextInput"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:gravity="top|start"
            android:background="@android:drawable/editbox_background"
            android:padding="8dp"
            android:text="@string/sample_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTestVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_test" />

        <Button
            android:id="@+id/btnOpenSettings"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_open_settings" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textColor="#333333"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
